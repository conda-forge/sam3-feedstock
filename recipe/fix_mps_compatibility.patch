diff --git a/sam3/perflib/fused.py b/sam3/perflib/fused.py
index 6800cca..e1bbb9f 100644
--- a/sam3/perflib/fused.py
+++ b/sam3/perflib/fused.py
@@ -12,14 +12,31 @@ def addmm_act(activation, linear, mat1):
         raise ValueError("Expected grad to be disabled.")
     self = linear.bias.detach()
     mat2 = linear.weight.detach()
-    self = self.to(torch.bfloat16)
-    mat1 = mat1.to(torch.bfloat16)
-    mat2 = mat2.to(torch.bfloat16)
-    mat1_flat = mat1.view(-1, mat1.shape[-1])
+
     if activation in [torch.nn.functional.relu, torch.nn.ReLU]:
-        y = addmm_act_op(self, mat1_flat, mat2.t(), beta=1, alpha=1, use_gelu=False)
-        return y.view(mat1.shape[:-1] + (y.shape[-1],))
-    if activation in [torch.nn.functional.gelu, torch.nn.GELU]:
-        y = addmm_act_op(self, mat1_flat, mat2.t(), beta=1, alpha=1, use_gelu=True)
+        use_gelu = False
+    elif activation in [torch.nn.functional.gelu, torch.nn.GELU]:
+        use_gelu = True
+    else:
+        raise ValueError(f"Unexpected activation {activation}")
+
+    # The fused _addmm_activation kernel is only fast on CUDA, where the
+    # historical bfloat16 cast also lands. Keep that path byte-for-byte so the
+    # CUDA-validated behaviour is unchanged.
+    if mat1.device.type == "cuda":
+        self = self.to(torch.bfloat16)
+        mat1 = mat1.to(torch.bfloat16)
+        mat2 = mat2.to(torch.bfloat16)
+        mat1_flat = mat1.view(-1, mat1.shape[-1])
+        y = addmm_act_op(self, mat1_flat, mat2.t(), beta=1, alpha=1, use_gelu=use_gelu)
         return y.view(mat1.shape[:-1] + (y.shape[-1],))
-    raise ValueError(f"Unexpected activation {activation}")
+
+    # Non-CUDA backends (CPU, MPS): the unconditional bfloat16 cast made the
+    # fused output disagree in dtype with the surrounding (unfused) Linear
+    # layers -- this raised on CPU and hard-aborted on MPS. _addmm_activation is
+    # also not implemented for the MPS device at all. Fall back to a plain,
+    # semantically equivalent linear + activation in the input's native dtype.
+    y = torch.nn.functional.linear(mat1, mat2, self)
+    if use_gelu:
+        return torch.nn.functional.gelu(y)
